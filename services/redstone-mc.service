[Unit]
Description=Redstone Minecraft Control Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orianafawkes
WorkingDirectory=/home/orianafawkes/redstone-mc
EnvironmentFile=/home/orianafawkes/redstone-mc/.env

ExecStart=/home/orianafawkes/redstone-mc/venv/bin/python bot.py

Restart=on-failure
RestartSec=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target